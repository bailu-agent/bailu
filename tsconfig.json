{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@bailu/chord": ["./packages/chord/src/index.ts"],
			"@bailu/chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@bailu/chord/context": ["./packages/chord/src/context/index.ts"],
			"@bailu/chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@bailu/chord/node": ["./packages/chord/src/node.ts"],
			"@bailu/telemetry": ["./packages/telemetry/src/index.ts"],
			"@bailu/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@bailu/ai": ["./packages/ai/src/index.ts"],
			"@bailu/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@bailu/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@bailu/ai/dist/*": ["./packages/ai/src/*"],
			"@bailu/agent-core": ["./packages/agent/src/index.ts"],
			"@bailu/agent-core/harness/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@bailu/agent-core/node": ["./packages/agent/src/node.ts"],
			"@bailu/agent-core/*": [
				"./packages/agent/src/*.ts",
				"./packages/agent/src/*/index.ts",
				"./packages/agent/src/*"
			],
			"@bailu/session-backend-sqlite-node": ["./packages/session-backends/sqlite-node/src/index.ts"],
			"@bailu/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@bailu/coding-agent/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@bailu/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@bailu/coding-agent/*": ["./packages/coding-agent/src/*"],
			"@bailu/protocol": ["./packages/protocol/src/index.ts"],
			"@bailu/protocol/*": ["./packages/protocol/src/*"],
			"@bailu/client": ["./packages/client/src/index.ts"],
			"@bailu/client/unix": ["./packages/client/src/unix.ts"],
			"@bailu/client/*": ["./packages/client/src/*"],
			"@bailu/server": ["./packages/server/src/index.ts"],
			"@bailu/server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@bailu/server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@bailu/tui": ["./packages/tui/src/index.ts"],
			"@bailu/tui/*": ["./packages/tui/src/*"],
			"@bailu/agent-old": ["./packages/agent-old/src/index.ts"],
			"@bailu/agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/session-backends/*/src/**/*", "packages/session-backends/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
